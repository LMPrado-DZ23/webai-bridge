{
  "id": "perplexity",
  "label": "Perplexity",
  "status": "ready",
  "url": "https://www.perplexity.ai/",
  "loginUrl": "https://www.perplexity.ai/",
  "models": [
    {
      "id": "perplexity-web",
      "displayName": "Perplexity (site-selected model)"
    }
  ],
  "selectors": {
    "composer": "textarea, [contenteditable='true']",
    "sendButton": "button[aria-label*='Submit' i], button[aria-label*='Send' i], button[type='submit']",
    "assistant": "[data-testid='answer'], .prose, [class*='prose'], .markdown, [class*='markdown']",
    "loginButton": "button:has-text('Sign in'), button:has-text('Log in'), a:has-text('Sign in'), a:has-text('Entrar'), button:has-text('Entrar')"
  },
  "timeouts": {
    "replyMs": 180000,
    "stableMs": 2500
  }
}
