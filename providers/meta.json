{
  "id": "meta",
  "label": "Meta AI",
  "status": "ready",
  "url": "https://www.meta.ai/",
  "loginUrl": "https://www.meta.ai/",
  "models": [
    {
      "id": "meta-ai",
      "displayName": "Meta AI (web)"
    }
  ],
  "selectors": {
    "composer": "textarea, [contenteditable='true']",
    "sendButton": "button[aria-label*='Send' i], button[type='submit']",
    "assistant": "[data-role='assistant'], .markdown, [class*='markdown'], .prose",
    "loginButton": "a:has-text('Entrar'), button:has-text('Entrar'), a:has-text('Log in'), button:has-text('Log in'), a:has-text('Sign in')"
  },
  "timeouts": {
    "replyMs": 180000,
    "stableMs": 2500
  }
}
