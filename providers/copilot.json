{
  "id": "copilot",
  "label": "Microsoft Copilot",
  "status": "planned",
  "url": "https://copilot.com/",
  "loginUrl": "https://copilot.com/",
  "models": [
    {
      "id": "copilot-web",
      "displayName": "Copilot (web)"
    }
  ],
  "selectors": {
    "composer": "textarea, [contenteditable='true']",
    "sendButton": "button[aria-label*='Send' i], button[type='submit']",
    "assistant": "[data-role='assistant'], .markdown, [class*='markdown'], .prose",
    "loginButton": "button:has-text('Sign in'), a:has-text('Sign in'), button:has-text('Entrar')"
  },
  "timeouts": {
    "replyMs": 180000,
    "stableMs": 2500
  }
}
