{
  "id": "grok",
  "label": "Grok",
  "status": "ready",
  "url": "https://grok.com/",
  "loginUrl": "https://grok.com/",
  "models": [
    {
      "id": "grok-web",
      "displayName": "Grok (web)"
    }
  ],
  "selectors": {
    "composer": "textarea, [contenteditable='true']",
    "sendButton": "button[type='submit'], button[aria-label*='Enviar' i], button[aria-label*='Send' i]",
    "assistant": ".response-content-markdown",
    "loginButton": "a:has-text('Entrar'), button:has-text('Entrar'), a:has-text('Sign in'), button:has-text('Sign in')",
    "completion": "Grok finished responding"
  },
  "timeouts": {
    "replyMs": 180000,
    "stableMs": 3000
  }
}
