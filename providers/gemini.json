{
  "id": "gemini",
  "label": "Gemini Web",
  "status": "ready",
  "url": "https://gemini.google.com/app",
  "loginUrl": "https://gemini.google.com/app",
  "models": [
    {
      "id": "gemini-pro",
      "displayName": "Gemini (web)"
    }
  ],
  "selectors": {
    "composer": "rich-textarea [contenteditable='true'], [contenteditable='true'], textarea",
    "sendButton": "button[aria-label*='Send' i], button[aria-label*='Enviar' i], button[type='submit']",
    "assistant": "model-response message-content .markdown, model-response .markdown",
    "loginButton": "a:has-text('Fazer login'), button:has-text('Fazer login'), button:has-text('Sign in'), a:has-text('Sign in')"
  },
  "timeouts": {
    "replyMs": 180000,
    "stableMs": 2500
  }
}
